# Kopiera till .env och fyll i egna värden. .env är gitignorad och ska
# ALDRIG committas. I produktion sätts samma värden som GitHub Actions
# repo secrets (Settings > Secrets and variables > Actions) och läses
# av .github/workflows/deploy.yml vid deploy.

SUPABASE_URL=
SUPABASE_ANON_KEY=
ADMIN_NAME=
ADMIN_PASSWORD=
